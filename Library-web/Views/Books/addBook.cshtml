@* File: Views/Books/addBook.cshtml *@
@model Library_web.Models.DTO.AddBookDTO

@{
    ViewData["Title"] = "Add New Book";
}

<h1>Add New Book</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Books" asp-action="addBook" method="POST">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>

            <div class="form-group">
                <label class="control-label">Đã đọc:</label>
                <div class="form-check">
                    <input type="radio" asp-for="IsRead" value="true" class="form-check-input" id="isReadYes">
                    <label class="form-check-label" for="isReadYes">Yes</label>
                </div>
                <div class="form-check">
                    <input type="radio" asp-for="IsRead" value="false" checked class="form-check-input" id="isReadNo">
                    <label class="form-check-label" for="isReadNo">No</label>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Rate" class="control-label"></label>
                <input asp-for="Rate" class="form-control" />
                <span asp-validation-for="Rate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Genre" class="control-label"></label>
                <input asp-for="Genre" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="CoverUrl" class="control-label"></label>
                <input asp-for="CoverUrl" class="form-control" />
            </div>

            @* Phần PublisherID và AuthorIDs: Cần ListBox/Select để chọn từ dữ liệu API. Tạm sử dụng Input ẩn cho PublisherID và bỏ qua AuthorIDs để đơn giản *@
            <div class="form-group">
                <label asp-for="PublisherID" class="control-label">Publisher (Chọn 1):</label>
                <select asp-for="PublisherID" class="form-control">
                    <option value="1">Nhà xuất bản A</option> @* Cần thay bằng dữ liệu thực *@
                    <option value="2">Nhà xuất bản B</option>
                </select>
            </div>

            @* Tạm bỏ qua list chọn tác giả để đơn giản *@

            <div class="form-group mt-3">
                <input type="submit" value="Add Book" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}